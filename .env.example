# Plantilla de variables de entorno. Copiar como `.env` real en cada entorno.
# Las de JWT/auth se agregarán cuando se implemente la autenticación.

# Puerto en el que escucha el backend.
APP_PORT=8000

# Base de datos. En el MVP se usa SQLite embebido; el archivo vive en el
# volumen `lifeos-data` (montado en /app/data dentro del contenedor).
DATABASE_URL=sqlite:///./data/lifeos.db
