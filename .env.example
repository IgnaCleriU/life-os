# Plantilla de variables de entorno. Copiar como `.env` real en cada entorno.
# Las de JWT/auth se agregarán cuando se implemente la autenticación.

# Puerto en el que escucha el backend.
APP_PORT=8000

# Base de datos. Opcional: si no se define, la app usa el directorio de datos
# del usuario (`$XDG_DATA_HOME/life-os/lifeos.db`, por defecto
# `~/.local/share/life-os/lifeos.db`), de modo que la API REST, el servidor
# MCP y la futura TUI comparten el mismo archivo sin configurar nada.
# Definirla solo para apuntar a otra base — por ejemplo dentro de Docker,
# donde el archivo vive en el volumen `lifeos-data` montado en /app/data:
# DATABASE_URL=sqlite:///./data/lifeos.db
