# Plantilla de variables de entorno. Copiar como `.env` real en cada entorno.

# Puerto en el que escucha el backend.
APP_PORT=8000

# Base de datos. Opcional: si no se define, la app usa el directorio de datos
# del usuario (`$XDG_DATA_HOME/life-os/lifeos.db`, por defecto
# `~/.local/share/life-os/lifeos.db`), de modo que la API REST, el servidor
# MCP y la futura TUI comparten el mismo archivo sin configurar nada.
# Definirla solo para apuntar a otra base — por ejemplo dentro de Docker,
# donde el archivo vive en el volumen `lifeos-data` montado en /app/data:
# DATABASE_URL=sqlite:///./data/lifeos.db

# Auth de la API REST (ADR 0009). Encendida por defecto: sin token, toda ruta
# salvo /health responde 401. `lifeos-daemon` genera su propio token; para una
# corrida manual (uvicorn, Docker) definir uno largo y aleatorio, por ejemplo
# con `python -c "import secrets; print(secrets.token_urlsafe(32))"`, y
# mandarlo como `Authorization: Bearer <token>`.
# LIFEOS_API_TOKEN=
# Solo para desarrollo local, nunca con el puerto expuesto:
# LIFEOS_API_AUTH=disabled

# Hosts aceptados además de localhost, separados por coma (ADR 0010/0012). Solo
# en un VPS: por ejemplo los nombres de Tailscale, para usar la API desde el
# teléfono vía `tailscale serve`. Vacío en el escritorio. Los dos backends (el
# de Python y el de Java) leen esta variable, igual que LIFEOS_API_TOKEN y
# LIFEOS_API_AUTH.
# LIFEOS_ALLOWED_HOSTS=lifeos-vps,lifeos-vps.<tailnet>.ts.net

# Solo backend Java: dirección en la que escucha (por defecto 127.0.0.1). La
# imagen Docker la fija en 0.0.0.0; no hace falta tocarla.
# LIFEOS_BIND_ADDRESS=127.0.0.1
