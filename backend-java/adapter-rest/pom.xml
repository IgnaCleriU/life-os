<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot: controllers, DTOs y el cableado (único lugar donde SQLite se conecta a los casos de uso). -->
    <parent>
        <groupId>lifeos</groupId>
        <artifactId>lifeos-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>lifeos-adapter-rest</artifactId>

    <properties>
        <lifeos.web.dir>${project.basedir}/../../frontend</lifeos.web.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>lifeos</groupId>
            <artifactId>lifeos-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>web</id>
            <build>
                <plugins>
                    <!--
                      Perfil `web` (mvn -Pweb package): arma el frontend con Node y lo
                      empaqueta en el jar, en static/app/. Sin el perfil el build no
                      necesita Node (el Dockerfile trae la web de otra etapa).
                      Va en prepare-package: `test` nunca lo ejecuta.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <configuration>
                            <executable>npm</executable>
                            <workingDirectory>${lifeos.web.dir}</workingDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>web-npm-ci</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>ci</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>web-build</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <arguments>
                                        <argument>run</argument>
                                        <argument>build</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>web-copy</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static/app</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${lifeos.web.dir}/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
