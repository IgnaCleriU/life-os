# Caddy delante de la API de Java en un VPS (ADR 0013). Solo corre con el
# perfil `public` de compose (ver compose.override.yml).
#
# Escucha únicamente el 443: el 80 queda cerrado, así que el certificado de
# Let's Encrypt sale por el desafío TLS-ALPN y no hay redirect de HTTP. Sin
# HTTP/3 para no tener que abrir también 443/udp.
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

{$LIFEOS_PUBLIC_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Monitor Beszel (perfil `monitor`, ADR 0014). El hub espera las rutas sin
	# el prefijo y arma sus links con APP_URL. Si el perfil está apagado,
	# /monitor/ responde 502. El timeout largo es el que pide Beszel.
	redir /monitor /monitor/ 308
	handle_path /monitor/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy beszel:8090 {
			transport http {
				read_timeout 360s
			}
		}
	}
	# Caddy reenvía el Host original: la guardia de Java lo valida contra
	# LIFEOS_ALLOWED_HOSTS, que tiene que incluir LIFEOS_PUBLIC_HOST.
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend-java:8000
	}
}
